{
  "name": "@tinker-start-scaffold",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./backend": "./src/backend/index.ts",
    "./frontend": "./src/frontend/index.ts",
    "./transport": "./src/scaffold/backend/index.server.ts",
    "./telemetry": "./src/scaffold/telemetry/index.ts",
    "./sync": "./src/scaffold/frontend/index.ts",
    "./testing": "./tests/presets.ts"
  },
  "scripts": {
    "dev": "node --env-file=.env node_modules/vite-plus/bin/vp dev",
    "build": "vp build",
    "start": "node --env-file=.env scripts/serve.mjs",
    "test": "vp test",
    "db:generate": "drizzle-kit generate",
    "test:boundary": "node scripts/check-boundary.mjs",
    "test:seam": "node scripts/check-seam.mjs --prove",
    "test:schema": "node scripts/check-schema.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "check:plain": "node scripts/check-plain.mjs",
    "check": "vp check && vp run typecheck && vp run test && vp run check:plain && vp run test:seam && vp run test:boundary && vp run test:schema"
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@tinker/core": "0.0.0",
    "@tinker/react": "0.0.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "1.0.0-rc.4",
    "nodemailer": "10.0.13",
    "pg": "8.20.0",
    "pino": "10.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "1.0.0-rc.4",
    "oxc-parser": "^0.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  },
  "intent": {
    "skills": [
      "@tanstack/react-start",
      "@tanstack/start-client-core",
      "@tanstack/start-server-core",
      "@tanstack/router-core"
    ]
  },
  "overrides": {
    "vite": "$vite"
  }
}
