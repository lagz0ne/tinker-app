{
  "name": "@tinker-start-scaffold",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./backend": "./src/backend/index.server.ts",
    "./frontend": "./src/frontend/index.ts",
    "./testing": "./tests/presets.ts"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "start": "tinker serve",
    "test": "vp test",
    "db:generate": "drizzle-kit generate",
    "test:imports": "node maintain/check-imports.mjs",
    "test:middleware": "node maintain/check-middleware.mjs",
    "test:serve": "node maintain/check-serve.mjs",
    "registry:build": "node maintain/build-registry.mjs",
    "test:registry": "node maintain/check-registry.mjs",
    "test:seam:fixture": "node maintain/check-seam-fixture.mjs",
    "test:schema": "node scripts/check-schema.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "check:plain": "node scripts/check-plain.mjs",
    "postinstall": "tinker prepare",
    "doctor": "tinker doctor",
    "test:compose": "node maintain/check-compose.mjs",
    "check": "node maintain/check-app.mjs"
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@tinker/core": "workspace:*",
    "@tinker/react": "workspace:*",
    "@tinker/start": "workspace:*",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "catalog:",
    "nodemailer": "10.0.13",
    "pg": "8.20.0",
    "pino": "10.3.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "3.7.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "catalog:",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "npm:^4.3.4",
    "drizzle-kit": "catalog:",
    "oxc-parser": "catalog:",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "typescript-api": "npm:typescript@5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "intent": {
    "skills": [
      "@tanstack/react-start",
      "@tanstack/start-client-core",
      "@tanstack/start-server-core",
      "@tanstack/router-core"
    ]
  }
}
