{
  "name": "@tinker-start-scaffold",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "start": "tinker serve",
    "setup": "node scripts/setup.mjs",
    "test": "vp test --maxWorkers=1 --no-file-parallelism",
    "db:generate": "drizzle-kit generate",
    "test:imports": "node maintain/check-imports.mjs",
    "test:middleware": "node maintain/check-middleware.mjs",
    "test:serve": "node maintain/check-serve.mjs",
    "registry:build": "node maintain/build-registry.mjs",
    "test:native-form": "node maintain/check-native-form.mjs && node maintain/check-native-form-control.mjs",
    "test:registry": "node maintain/check-registry.mjs",
    "test:registry-hook": "node --test maintain/test-registry-staged.mjs",
    "test:seam:fixture": "node maintain/check-seam-fixture.mjs",
    "test:schema": "node scripts/check-schema.mjs",
    "typecheck": "node maintain/sqlite-dev-db.mjs && DATABASE_URL=file:.tinker/sqlite-dev.db node node_modules/typescript/bin/tsc --noEmit --runExternalCode",
    "check:plain": "node scripts/check-plain.mjs",
    "postinstall": "tinker prepare",
    "doctor": "tinker doctor",
    "test:compose": "node maintain/check-compose.mjs",
    "check": "node maintain/check-app.mjs",
    "mutate": "stryker run",
    "test:template": "node maintain/check-template.mjs",
    "test:export": "node maintain/proof-export.mjs",
    "check:commands": "node maintain/check-commands.mjs",
    "test:proofs": "node maintain/proof-server-close.mjs && node maintain/proof-exit-controls.mjs && node maintain/proof-bootstrap-controls.mjs",
    "gate:commands": "node node_modules/@tinker/start/lib/command-gate.mjs",
    "build:worker": "vp build --config vite.worker.config.ts",
    "worker": "node maintain/worker.mjs",
    "test:migrations": "node maintain/proof-migration-contract.mjs && node maintain/proof-migration-contract-controls.mjs",
    "test:agent-live": "node maintain/proof-agent-live.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.295",
    "@better-auth/kysely-adapter": "1.7.7",
    "@hono/node-server": "1.19.17",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@tinker/core": "https://github.com/lagz0ne/tinkered/releases/download/start-v0.9.0/tinker-core-0.9.0.tgz",
    "@tinker/react": "https://github.com/lagz0ne/tinkered/releases/download/start-v0.9.0/tinker-react-0.9.0.tgz",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "catalog:",
    "kysely": "0.29.6",
    "nodemailer": "10.0.13",
    "pg": "8.20.0",
    "pino": "10.3.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "reylo": "0.6.0",
    "tailwind-merge": "3.7.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@reylosql/sqlite": "0.6.0",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@tailwindcss/vite": "4.3.3",
    "@tinker/loop": "workspace:*",
    "@tinker/start": "workspace:*",
    "@types/node": "catalog:",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "npm:^4.3.4",
    "drizzle-kit": "catalog:",
    "oxc-parser": "catalog:",
    "tailwindcss": "4.3.3",
    "typescript": "7.1.0-beta",
    "typescript-api": "npm:typescript@5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "intent": {
    "skills": [
      "@tanstack/react-start",
      "@tanstack/start-client-core",
      "@tanstack/start-server-core",
      "@tanstack/router-core"
    ]
  }
}
