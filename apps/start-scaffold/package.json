{
  "name": "@tinker-start-scaffold",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./backend": "./src/backend/index.ts",
    "./frontend": "./src/frontend/index.ts",
    "./transport": "./src/scaffold/backend/index.server.ts",
    "./telemetry": "./src/scaffold/telemetry/index.ts",
    "./sync": "./src/scaffold/frontend/index.ts",
    "./proof": "./src/proof.ts"
  },
  "scripts": {
    "dev": "START_PROOF_MODE=1 vp dev --host ${HOST:-127.0.0.1} --port ${PORT:-4318}",
    "build": "vp build",
    "start": "node scripts/serve.mjs",
    "test": "vp test",
    "db:generate": "drizzle-kit generate",
    "test:boundary": "node scripts/check-boundary.mjs",
    "test:imports": "node scripts/check-imports.mjs",
    "test:middleware": "node scripts/check-middleware.mjs",
    "registry:build": "vp dlx -- shadcn@4.21.0 build && vp fmt public/r",
    "test:registry": "node scripts/check-registry.mjs",
    "test:seam": "node scripts/check-seam.mjs --prove",
    "test:seam:fixture": "node scripts/check-seam-fixture.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "catalog:",
    "@hono/node-server": "1.19.17",
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@tinker/core": "workspace:*",
    "@tinker/react": "workspace:*",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "catalog:",
    "nodemailer": "10.0.13",
    "pg": "8.20.0",
    "pino": "10.3.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "3.7.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "catalog:",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "npm:^4.3.4",
    "drizzle-kit": "catalog:",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "intent": {
    "skills": [
      "@tanstack/react-start",
      "@tanstack/start-client-core",
      "@tanstack/start-server-core",
      "@tanstack/router-core"
    ]
  }
