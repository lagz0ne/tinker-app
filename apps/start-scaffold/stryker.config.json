{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner", "./scripts/mutation-arid.mjs"],
  "mutate": [
    "tinker/**/*.ts",
    "tinker/**/*.tsx",
    "src/demo/**/*.ts",
    "src/demo/**/*.tsx",
    "src/backend/**/*.ts",
    "src/transport/**/*.ts",
    "src/contracts/**/*.ts",
    "cmds/**/*.ts",
    "!tinker/base/server-entry.ts",
    "!tinker/base/router-entry.tsx",
    "!tinker/base/start-entry.ts",
    "!tinker/base/fallbacks.tsx",
    "!src/routes/**",
    "!tinker/components/sync/functions.ts"
  ],
  "ignorePatterns": ["tsconfig.json", "node_modules", ".tinker"],
  "reporters": ["clear-text", "progress", "json"],
  "thresholds": {
    "high": 90,
    "low": 60,
    "break": 60
  },
  "tempDirName": ".stryker-tmp",
  "concurrency": 1,
  "timeoutMS": 15000,
  "vitest": {
    "related": false
  },
  "ignoreStatic": true,
  "ignorers": ["arid"],
  "dryRunTimeoutMinutes": 10
}
