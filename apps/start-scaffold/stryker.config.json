{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutate": [
    "tinker/**/*.ts",
    "tinker/**/*.tsx",
    "src/demo/**/*.ts",
    "src/demo/**/*.tsx",
    "!tinker/base/server-entry.ts",
    "!tinker/base/router-entry.tsx",
    "!tinker/base/start-entry.ts",
    "!tinker/base/fallbacks.tsx",
    "!src/routes/**",
    "!tinker/components/sync/functions.ts"
  ],
  "ignorePatterns": ["dist", "node_modules", ".tinker"],
  "reporters": ["clear-text", "progress", "json"],
  "thresholds": {
    "high": 90,
    "low": 85,
    "break": 85
  },
  "tempDirName": ".stryker-tmp",
  "concurrency": 1,
  "timeoutMS": 15000,
  "vitest": {
    "related": false
  }
}
