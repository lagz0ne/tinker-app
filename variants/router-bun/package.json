{
  "name": "tinker-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot cmds/dev.ts",
    "build": "rm -rf dist && bun run build:client && bun run build:server && bun run check:client",
    "build:client": "bun build cmds/index.html --target=browser --production --splitting --outdir dist/client --metafile=dist/client-meta.json",
    "build:server": "bun build cmds/host.ts cmds/telemetry-worker.ts --target=bun --production --root cmds --outdir dist/server",
    "check:client": "bun scripts/check-client.ts dist/client-meta.json",
    "start": "NODE_ENV=production bun dist/server/host.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.41",
    "@tinker/core": "https://github.com/lagz0ne/tinkered/releases/download/start-v0.10.0/tinker-core-0.10.0.tgz",
    "@tinker/react": "https://github.com/lagz0ne/tinkered/releases/download/start-v0.10.0/tinker-react-0.10.0.tgz",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^7.0.2"
  }
}
