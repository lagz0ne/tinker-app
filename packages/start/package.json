{
  "name": "@tinker/start",
  "version": "0.7.0",
  "private": true,
  "description": "The Tinkered Start base: entries, routes, tinker(), and the tinker command (ADR 0106).",
  "bin": {
    "tinker": "./bin/tinker.mjs"
  },
  "files": [
    "bin",
    "lib",
    "src",
    "vite.mjs",
    "vite.d.mts",
    "files.json",
    "UPGRADE.md",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./client": "./src/client.ts",
    "./vite": {
      "types": "./vite.d.mts",
      "default": "./vite.mjs"
    },
    "./package.json": "./package.json",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "release": "node scripts/pack.mjs",
    "test": "vp test",
    "mutate": "stryker run",
    "check": "vp check"
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "@tanstack/virtual-file-routes": "1.162.0",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-orm": "catalog:",
    "jsonc-parser": "^3.3.1",
    "oxc-parser": "^0.117.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@tinker/core": "workspace:*",
    "@tinker/react": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@tinker/core": "*",
    "@tinker/react": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "tinker": {
    "tested": {
      "@tanstack/react-router": "1.170.41",
      "@tanstack/react-start": "1.168.60",
      "@tinker/core": "0.7.0",
      "@tinker/react": "0.7.0"
    },
    "routes": {
      "/api/health": "src/routes/api.health.ts",
      "/tinker": "src/routes/tinker.tsx"
    },
    "parts": {
      "telemetry": {
        "on": true,
        "entries": {
          "router": "on.ts",
          "server": "on.server.ts"
        },
        "routes": {
          "/api/telemetry": "src/routes/api.telemetry.ts"
        },
        "env": {
          "VICTORIA_TRACES_URL": {
            "default": "http://127.0.0.1:10428/insert/opentelemetry/v1/traces",
            "rule": "http"
          },
          "VICTORIA_LOGS_URL": {
            "default": "http://127.0.0.1:9428/insert/jsonline",
            "rule": "http"
          },
          "OTEL_SERVICE_NAME": {
            "default": "tinker-app"
          }
        }
      },
      "auth": {
        "on": false,
        "entries": {
          "server": "on.server.ts"
        },
        "routes": {
          "/api/auth/$": "src/routes/api.auth.ts"
        },
        "reads": {
          "src/lib/tinker.server.ts": [
            "auth",
            "readAccount"
          ]
        },
        "env": {
          "PUBLIC_ORIGIN": {
            "rule": "http"
          },
          "AUTH_SECRET": {
            "rule": "secret"
          }
        }
      },
      "sync": {
        "on": false,
        "needs": [
          "auth"
        ],
        "entries": {
          "router": "on.ts"
        },
        "routes": {
          "/api/sync": "src/routes/api.sync.ts"
        },
        "reads": {
          "src/lib/tinker.server.ts": [
            "database",
            "bootstrap"
          ],
          "src/lib/tinker.ts": [
            "records",
            "readSnapshot",
            "readBootstrap",
            "readBatch",
            "streamMessage"
          ]
        },
        "augments": {
          "@tinker/start": [
            "Register"
          ]
        },
        "env": {}
      }
    }
  }
}
