{
  "name": "@tinker/start",
  "version": "0.2.0",
  "private": true,
  "description": "The Tinkered Start base: entries, routes, tinker(), and the tinker command (ADR 0106).",
  "bin": {
    "tinker": "./bin/tinker.mjs"
  },
  "files": [
    "bin",
    "lib",
    "src",
    "vite.mjs",
    "vite.d.mts",
    "files.json",
    "UPGRADE.md",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./vite": {
      "types": "./vite.d.mts",
      "default": "./vite.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "release": "node scripts/pack.mjs",
    "test": "vp test",
    "mutate": "stryker run",
    "check": "vp check"
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "@tanstack/virtual-file-routes": "1.162.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsonc-parser": "^3.3.1",
    "oxc-parser": "^0.117.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@tinker/core": "workspace:*",
    "@tinker/react": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@tinker/core": "*",
    "@tinker/react": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "tinker": {
    "tested": {
      "@tanstack/react-router": "1.170.41",
      "@tanstack/react-start": "1.168.60",
      "@tinker/core": "0.0.0",
      "@tinker/react": "0.0.0"
    },
    "routes": {
      "/api/health": "src/routes/api.health.ts",
      "/tinker": "src/routes/tinker.tsx"
    }
  }
}
