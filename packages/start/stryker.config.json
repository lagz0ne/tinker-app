{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutate": [
    "lib/**/*.mjs",
    "src/**/*.ts",
    "src/**/*.tsx",
    "!src/entry/server.ts",
    "!src/entry/router.tsx",
    "!src/entry/start.ts",
    "!src/entry/fallbacks.tsx",
    "!src/routes/**",
    "!src/parts/sync/functions.ts",
    "!src/defaults/app.ts",
    "!src/defaults/app.server.ts",
    "!src/defaults/router.ts",
    "!src/defaults/start.ts"
  ],
  "ignorePatterns": ["tsconfig.json", "packs", "files.json"],
  "reporters": ["clear-text", "progress", "json"],
  "thresholds": {
    "high": 90,
    "low": 75,
    "break": 75
  },
  "tempDirName": ".stryker-tmp",
  "concurrency": 4,
  "timeoutMS": 15000
}
