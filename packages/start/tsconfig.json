{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "~/*": ["../../apps/start-scaffold/tinker/*"]
    }
  },
  "include": ["vite.config.ts", "vite.d.mts", "tests/fixtures/server.ts"]
}
