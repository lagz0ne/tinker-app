{
  "name": "@tinker/loop",
  "version": "0.0.0",
  "private": true,
  "description": "Gate checks and one findings file for a writer's design, check, review, and fix loop.",
  "bin": {
    "tinker-loop": "./bin/tinker-loop.mjs"
  },
  "files": [
    "bin",
    "dist-cli",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vp test",
    "typecheck": "tsc --noEmit",
    "check": "vp check",
    "doctor": "tinker doctor",
    "check-plain": "node ../../apps/start-scaffold/scripts/check-plain.mjs .",
    "gate:commands": "node node_modules/@tinker/start/lib/command-gate.mjs",
    "prepare": "tinker prepare && vp build --config vite.cli.config.ts",
    "mutate": "stryker run",
    "mutate:diff": "node maintain/mutate-diff.mjs"
  },
  "dependencies": {
    "@tinker/core": "https://github.com/lagz0ne/tinkered/releases/download/start-v0.9.0/tinker-core-0.9.0.tgz",
    "@tinker/start": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "catalog:",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
