{
  "name": "tinker-app",
  "version": "0.25.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run db:generate && bun cmds/dev.ts",
    "db:generate": "bun scripts/db-generate.ts",
    "build": "rm -rf dist && bun run build:client && bun run build:server && bun run check:client && bun run check:tests",
    "build:client": "bun --bun vp build && bun scripts/embed-client.ts",
    "build:server": "bun build cmds/host.ts cmds/telemetry-worker.ts --compile --bytecode --format=esm --minify --sourcemap=linked --define process.env.NODE_ENV='\"production\"' --metafile=dist/meta.json --outfile dist/server",
    "check:client": "bun scripts/check-client.ts dist/client-meta.json",
    "check:tests": "bun scripts/check-no-tests.ts dist/client-meta.json dist/meta.json",
    "start": "dist/server",
    "typecheck": "bun scripts/embed-client.ts && bun --bun tsc --noEmit",
    "test": "bun --bun vp test",
    "check": "bun run typecheck && bun run test && bun run build",
    "check:style": "bun --bun vp check",
    "check:plain": "bun --bun tinker-analyze check"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.41",
    "@tinkered/bun": "^0.18.0",
    "@tinkered/core": "^0.18.0",
    "@tinkered/react": "^0.18.0",
    "drizzle-orm": "1.0.0-rc.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@tanstack/intent": "0.5.6",
    "@tinkered/analyze": "^0.18.0",
    "@types/bun": "^1.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/browser-playwright": "5.0.1",
    "drizzle-kit": "1.0.0-rc.4",
    "playwright": "1.63.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  },
  "intent": {
    "skills": [
      "@tinkered/*"
    ]
  }
}
