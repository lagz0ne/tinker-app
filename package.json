{
  "name": "@tinker-start-scaffold",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "start": "tinker serve",
    "setup": "node scripts/setup.mjs",
    "test": "vp test --maxWorkers=1 --no-file-parallelism",
    "db:generate": "drizzle-kit generate",
    "test:schema": "node scripts/check-schema.mjs",
    "typecheck": "node maintain/sqlite-dev-db.mjs && DATABASE_URL=file:.tinker/sqlite-dev.db node node_modules/typescript/bin/tsc --noEmit --runExternalCode",
    "check:plain": "node scripts/check-plain.mjs",
    "postinstall": "tinker prepare",
    "doctor": "tinker doctor",
    "check": "vp run gate:commands && vp check && vp run typecheck && vp run test && vp run test:proofs && vp run check:plain && vp run test:schema && vp run doctor",
    "mutate": "stryker run",
    "test:proofs": "node maintain/proof-server-close.mjs && node maintain/proof-exit-controls.mjs && node maintain/proof-bootstrap-controls.mjs",
    "gate:commands": "node node_modules/@tinker/start/lib/command-gate.mjs",
    "build:worker": "vp build --config vite.worker.config.ts",
    "worker": "node maintain/worker.mjs",
    "test:migrations": "node maintain/proof-migration-contract.mjs && node maintain/proof-migration-contract-controls.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.295",
    "@better-auth/kysely-adapter": "1.7.7",
    "@better-auth/mcp": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "@hono/node-server": "1.19.17",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@tinker/core": "https://github.com/lagz0ne/tinkered/releases/download/start-v0.9.0/tinker-core-0.9.0.tgz",
    "@tinker/react": "https://github.com/lagz0ne/tinkered/releases/download/start-v0.9.0/tinker-react-0.9.0.tgz",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "1.0.0-rc.4",
    "kysely": "0.29.6",
    "nodemailer": "10.0.13",
    "pg": "8.20.0",
    "pino": "10.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reylo": "0.6.0",
    "tailwind-merge": "3.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@reylosql/sqlite": "0.6.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@tinker/start": "https://github.com/lagz0ne/tinker-app/releases/download/start-v0.16.0/tinker-start-0.16.0.tgz",
    "@types/node": "^24",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "1.0.0-rc.4",
    "oxc-parser": "^0.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.1.0-beta",
    "typescript-api": "npm:typescript@5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  },
  "overrides": {
    "@better-auth/core": "1.7.7",
    "@better-auth/utils": "0.4.2",
    "better-call": "1.4.0",
    "typescript": "7.1.0-beta",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "intent": {
    "skills": [
      "@tanstack/react-start",
      "@tanstack/start-client-core",
      "@tanstack/start-server-core",
      "@tanstack/router-core"
    ]
  }
}
