{
  "name": "tinker-app",
  "version": "0.21.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run db:generate && bun --hot cmds/dev.ts",
    "db:generate": "bun scripts/db-generate.ts",
    "build": "rm -rf dist && bun run build:client && bun run build:server && bun run check:client && bun run check:tests",
    "build:client": "bun build cmds/index.html --target=browser --production --splitting --public-path=/ --outdir dist/client --metafile=dist/client-meta.json",
    "build:server": "bun build cmds/host.ts cmds/telemetry-worker.ts --target=bun --production --root cmds --outdir dist/server --metafile=dist/server-meta.json",
    "check:client": "bun scripts/check-client.ts dist/client-meta.json",
    "check:tests": "bun scripts/check-no-tests.ts dist/client-meta.json dist/server-meta.json",
    "start": "NODE_ENV=production bun dist/server/host.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun run test && bun run build",
    "check:style": "vp check",
    "check:plain": "bun scripts/check-plain.ts"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.41",
    "@tinker/core": "https://github.com/lagz0ne/tinkered/releases/download/v0.14.1/tinker-core-0.14.1.tgz",
    "@tinker/react": "https://github.com/lagz0ne/tinkered/releases/download/v0.14.1/tinker-react-0.14.1.tgz",
    "drizzle-orm": "1.0.0-rc.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@types/bun": "^1.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "1.0.0-rc.4",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  }
}
