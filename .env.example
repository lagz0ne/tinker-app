# Config is capsule keys, filled by cmds/server.ts. A missing key exits 78.
# telemetry: OTEL_SERVICE_NAME, VICTORIA_TRACES_URL, VICTORIA_LOGS_URL
# Safe defaults: LOG_LEVEL = 30 (20, 30, 40, 50); SPAN_HISTORY = 80.
# PORT = 4318. NODE_ENV=production sends telemetry from a worker thread.
# PUBLIC_ORIGIN = the origin tabs call from (https://app.example); set it behind a TLS proxy.
